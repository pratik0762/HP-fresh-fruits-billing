# Server Configuration
PORT=5000
NODE_ENV=development

# Authentication
JWT_SECRET=super_secret_jwt_key_hp_fresh_fruits_erp_2026_ledger
JWT_EXPIRES_IN=7d

# Second secret required by the /db-admin web UI and its API (generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))")
DB_ADMIN_TOKEN=change_me_random_hex

# Database Configuration (PostgreSQL primary, SQLite zero-config fallback)
# For PostgreSQL in production or local setup:
# DB_DIALECT=postgres
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fruit_erp
# Or specify individual parameters:
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=fruit_erp
# DB_USER=postgres
# DB_PASSWORD=postgres

# Default for local instant development without pre-installed PostgreSQL:
DB_DIALECT=sqlite
DB_STORAGE=./data/fruit_erp.sqlite

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173
